{
  "name": "alppy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/web/**/*.css\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @alppy/web test:e2e",
    "i18n:check": "node scripts/check-i18n.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
