{#-
  One statement in the statement region. No bubbles here: the bubbles live at
  fixed coordinates in the answer grid at the foot of the page. What the student
  reads and what the machine reads are deliberately separate.

  `open` items get a delimited answer box and no bubbles at all. The box is what
  the scan job crops for the vision grader: its border and corner ticks are
  drawn as borders, its guide pattern as inline SVG, so all of it prints with
  background graphics off. Its height is decided by pagination and written
  inline; its printed position is measured at render time, never assumed.

  An item with a figure prints the crop of the textbook page instead of its
  statement text. The crop is sized by pagination, not by CSS, so the height
  it reserved and the height it prints are the same number.
-#}
<article class="print-item" data-item-index="{{ item.item_index }}" data-number="{{ item.number }}" data-type="{{ item.type }}"{% if item.ai_generated %} data-ai-generated="true"{% endif %}{% if item.figure %} data-figure="true"{% endif %}>
  {%- if item.figure %}
  {#- A crop of the textbook page IS the statement: the figure, the table, the
      fractions, in the book's own setting. The text lives in the alt so the
      document still reads without images. -#}
  <p class="print-item-statement" data-student-facing="true"><span class="sheet-item-number">{{ item.number }}.</span>{% if item.ai_generated %}<span class="sheet-ai-mark">{{ t.ai }}</span>{% endif %}{% if item.figure.show_statement %}{{ item.statement }}{% endif %}</p>
  <img class="sheet-figure" src="{{ item.figure.src }}" alt="{{ item.figure.alt }}" style="width: {{ item.figure.width_mm }}mm; height: {{ item.figure.height_mm }}mm">
  {%- else %}
  <p class="print-item-statement" data-student-facing="true"><span class="sheet-item-number">{{ item.number }}.</span>{% if item.ai_generated %}<span class="sheet-ai-mark">{{ t.ai }}</span>{% endif %}{{ item.statement }}</p>
  {%- endif %}
  {%- if item.options %}
  <ul class="sheet-options" data-student-facing="true">
    {%- for option in item.options %}
    <li class="sheet-option"><span class="sheet-option-letter">{{ option.letter }}</span><span class="sheet-option-text">{{ option.text }}</span></li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- if item.is_open %}
  {%- if item.open_lines > 0 %}
  <div class="sheet-answer-box" data-answer-box="true" data-fill="{{ item.box_fill }}" data-lines="{{ item.open_lines }}" style="height: {{ item.box_height_mm }}mm" aria-hidden="true">
    {%- if item.box_fill != 'blank' %}
    <svg class="sheet-answer-box-guides" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <defs>
        {%- if item.box_fill == 'grid' %}
        <pattern id="box-guides-{{ page.number }}-{{ item.item_index }}" patternUnits="userSpaceOnUse" width="{{ g.box_grid_px }}" height="{{ g.box_grid_px }}">
          <path d="M {{ g.box_grid_px }} 0 L 0 0 0 {{ g.box_grid_px }}" class="sheet-answer-box-guide"/>
        </pattern>
        {%- else %}
        <pattern id="box-guides-{{ page.number }}-{{ item.item_index }}" patternUnits="userSpaceOnUse" width="8" height="{{ g.box_line_px }}">
          <path d="M 0 {{ g.box_line_px }} L 8 {{ g.box_line_px }}" class="sheet-answer-box-guide"/>
        </pattern>
        {%- endif %}
      </defs>
      <rect width="100%" height="100%" fill="url(#box-guides-{{ page.number }}-{{ item.item_index }})"/>
    </svg>
    {%- endif %}
    <span class="sheet-answer-box-tick" data-corner="tl"></span>
    <span class="sheet-answer-box-tick" data-corner="tr"></span>
    <span class="sheet-answer-box-tick" data-corner="bl"></span>
    <span class="sheet-answer-box-tick" data-corner="br"></span>
  </div>
  {%- endif %}
  {%- if is_key and item.answer_text %}
  <p class="sheet-key-answer" data-key-only="true">{{ t.expected }} {{ item.answer_text }}</p>
  {%- endif %}
  {%- endif %}
</article>
