# Copy to .env and adjust as needed. `docker compose up` works unmodified
# with everything below: no API key is required (the AI layer's offline
# "echo"/"hash" providers — see apps/api/alppy/ai/providers.py — make the
# whole product demoable with zero external dependencies). Never commit a
# real secret here; this file only ever holds placeholders.
#
# Every ALPPY_* variable below is read by apps/api/alppy/core/config.py
# — with one exception, ALPPY_API_ORIGIN, which belongs to apps/web —
# (pydantic-settings, prefix "ALPPY_", case-insensitive). Tuple-typed
# settings (marked below) take a JSON array in the environment.

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
# One of: local | ci | staging | production.
ALPPY_ENV=local
# Verbose console logging + human-readable (non-JSON) log lines.
ALPPY_DEBUG=true

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
# Signs the session cookie (itsdangerous). CHANGE THIS in any real deployment
# — the default below is only safe on a laptop that never leaves localhost.
ALPPY_SECRET_KEY=dev-only-change-me
ALPPY_SESSION_COOKIE=alppy_session
# 12 hours, in seconds.
ALPPY_SESSION_MAX_AGE_S=43200

# --------------------------------------------------------------------------
# Database (PostgreSQL + pgvector — see infra/postgres/init.sql)
# --------------------------------------------------------------------------
# Matches the `postgres` service in docker-compose.yml. Use psycopg's
# "postgresql+psycopg://" scheme, not the bare "postgresql://".
ALPPY_DATABASE_URL=postgresql+psycopg://alppy:alppy@localhost:5432/alppy

# --------------------------------------------------------------------------
# Redis (arq job queue + short-lived job status)
# --------------------------------------------------------------------------
ALPPY_REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# Object storage (MinIO locally, any S3-compatible bucket in production)
# --------------------------------------------------------------------------
ALPPY_S3_ENDPOINT_URL=http://localhost:9000
ALPPY_S3_REGION=eu-central-1
ALPPY_S3_BUCKET=alppy
ALPPY_S3_ACCESS_KEY=alppy
ALPPY_S3_SECRET_KEY=alppy-secret

# --------------------------------------------------------------------------
# AI layer (apps/api/alppy/ai/) — provider-agnostic by design.
# --------------------------------------------------------------------------
# Generation. "echo" is the offline, deterministic stand-in used whenever no
# key is configured (or when ai_chat_provider=echo is set explicitly, e.g. in
# CI) — see docs/adr/0001-embeddings-provider.md and docs/privacy.md for why
# a Swiss school may require this to stay "echo" / self-hosted permanently.
ALPPY_AI_CHAT_PROVIDER=anthropic
ALPPY_AI_CHAT_MODEL=claude-sonnet-5
# Leave empty to fall back to the offline "echo" provider automatically.
ALPPY_ANTHROPIC_API_KEY=

# Embeddings. "hash" is a deterministic offline stand-in (no network, no
# key); "local" is the self-hosted multilingual model from ADR 0001.
ALPPY_AI_EMBEDDINGS_PROVIDER=hash
ALPPY_AI_EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
# Must match the `vector(N)` column width in the initial migration
# (apps/api/alembic/versions/0001_initial.py) if you ever change it.
ALPPY_EMBEDDING_DIM=1024

# Hard caps so a runaway prompt or a misbehaving client cannot bill the
# school or exhaust the provider's rate limit.
ALPPY_AI_MAX_OUTPUT_TOKENS=2048
ALPPY_AI_RATE_LIMIT_PER_MIN=20

# --------------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------------
ALPPY_MAX_UPLOAD_MB=50
# JSON array (tuple-typed setting).
ALPPY_ALLOWED_UPLOAD_TYPES=["application/pdf","image/jpeg","image/png","image/webp","image/heic","image/heif"]

# --------------------------------------------------------------------------
# Locale & CORS
# --------------------------------------------------------------------------
# One of: fr | de | en. fr is the product default (Suisse romande first).
ALPPY_DEFAULT_LOCALE=fr
# JSON array (tuple-typed setting). Add the deployed web origin in staging/prod.
ALPPY_CORS_ORIGINS=["http://localhost:3000"]

# ==========================================================================
# apps/web (Next.js) — NEXT_PUBLIC_* variables are baked into the client
# bundle at build time, so never put a secret in one.
# ==========================================================================
# Where the browser sends API requests.
#
# `docker compose up` publishes the API on the host at :8000 and the web app at
# :3000 — two different origins — so the browser needs an absolute URL. A
# relative /api/v1 only works behind a reverse proxy that puts both on one
# origin; it was the default here, and it made every request from the
# containerised web app a 404 against the web container itself.
#
# Behind such a proxy, set this to /api/v1 and add the proxy's origin to
# ALPPY_CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Where the Worker (or any reverse proxy) forwards /api/v1 to, when the browser
# is calling a *relative* /api/v1 instead of an absolute URL. This is the
# Cloudflare deployment's mode — see docs/deploy-cloudflare.md.
#
# Despite the ALPPY_ prefix this one is NOT an API setting: it is read by
# apps/web/next.config.ts and compiled into the routes manifest at BUILD time,
# so changing it means rebuilding, not restarting. It must not carry a port
# (":8443" is parsed as a path parameter and the build fails).
#
# Leave it empty for `docker compose up`, which puts the API on its own origin
# and uses NEXT_PUBLIC_API_BASE_URL above instead. Set one or the other, never
# both: an absolute NEXT_PUBLIC_API_BASE_URL wins and the rewrite goes unused.
ALPPY_API_ORIGIN=

# Set to "1" to force the web app's mock/offline data mode (used by e2e and
# local UI work with no API running at all). Leave unset otherwise.
NEXT_PUBLIC_ALPPY_MOCK=
